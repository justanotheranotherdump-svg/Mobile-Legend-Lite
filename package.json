{
  "name": "moba-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run validate:heroes && vite build && node scripts/package-html.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "validate:offline": "node scripts/check-offline.mjs",
    "package:source": "npm run build && node scripts/package-source.mjs",
    "validate:heroes": "node scripts/validate-heroes.mjs",
    "test:browser:layla": "node tests/browser-layla.mjs",
    "test:browser:panels": "node tests/browser-panels.mjs",
    "test:browser:menu": "node tests/browser-menu.mjs",
    "test:browser:polish": "node tests/browser-polish.mjs",
    "test:browser:heroes": "node tests/browser-hero-browser.mjs",
    "test:browser:progression": "node tests/browser-progression.mjs",
    "test:browser:match": "node tests/browser-match.mjs",
    "test:browser:recovery": "node tests/browser-recovery.mjs",
    "test:browser:roster": "node tests/browser-roster.mjs",
    "test:browser:draft": "node tests/browser-draft.mjs",
    "test:browser:batch1": "node tests/browser-batch1.mjs",
    "test:browser:shop-spells": "node tests/browser-shop-spells.mjs",
    "test:browser:game-polish": "node tests/browser-game-polish.mjs",
    "test:browser:preparation": "node tests/browser-preparation-expansion.mjs",
    "validate:preparation-assets": "node scripts/verify-preparation-assets.mjs",
    "test:browser:preparation:regression": "node scripts/run-preparation-regressions.mjs",
    "validate:preparation-delivery": "node scripts/audit-preparation-delivery.mjs",
    "test:browser:preparation:isolated": "node scripts/verify-preparation-isolated.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "playwright-core": "1.64.1",
    "vite": "7.3.7"
  }
}
