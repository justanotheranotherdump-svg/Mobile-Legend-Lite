{
  "name": "moba-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run validate:heroes && vite build && node scripts/package-html.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "validate:offline": "node scripts/check-offline.mjs",
    "package:source": "npm run build && node scripts/package-source.mjs",
    "validate:heroes": "node scripts/validate-heroes.mjs",
    "test:browser:layla": "node tests/browser-layla.mjs",
    "test:browser:panels": "node tests/browser-panels.mjs",
    "test:browser:menu": "node tests/browser-menu.mjs",
    "test:browser:polish": "node tests/browser-polish.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "playwright-core": "1.64.1",
    "vite": "7.3.7"
  }
}
